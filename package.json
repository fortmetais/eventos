{
  "name": "campamentos-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run dev -w @fac/api\" \"npm run dev -w @fac/web\"",
    "build": "npm run build -w @fac/api && npm run build -w @fac/web",
    "build:hostinger": "npm ci --include=dev && npm run db:generate && npm run build && node scripts/check-hostinger-startup.mjs",
    "start": "node apps/api/dist/index.js",
    "test": "npm run test -w @fac/api && npm run test -w @fac/web",
    "test:database": "node scripts/test-database.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "test:browser:initial": "node scripts/browser-initial-check.mjs",
    "test:browser:invitation": "node scripts/browser-invitation-check.mjs",
    "test:browser:events": "node scripts/browser-event-setups-check.mjs",
    "test:browser:volunteers": "node scripts/browser-volunteer-check.mjs",
    "typecheck": "npm run typecheck --workspaces",
    "db:generate": "npm run db:generate -w @fac/api",
    "db:check": "npm run db:check -w @fac/api",
    "auth:check": "npm run auth:check -w @fac/api",
    "db:migrate": "npm run db:migrate -w @fac/api",
    "db:deploy": "npm run db:deploy -w @fac/api",
    "db:seed": "npm run db:seed -w @fac/api",
    "admin:bootstrap": "npm run admin:bootstrap -w @fac/api",
    "storage:setup": "npm run storage:setup -w @fac/api",
    "drafts:cleanup": "npm run drafts:cleanup -w @fac/api",
    "format": "prettier --write \"apps/**/*.{ts,tsx,json,css,html}\" \"scripts/**/*.mjs\" \"docs/**/*.md\" \"*.{json,md,yaml}\""
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.6.2"
  },
  "overrides": {
    "shell-quote": "1.12.0",
    "vite": "8.3.3"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
