NODE_ENV=development
EVENTS_ENABLED=false
EVENT_MANAGEMENT_ENABLED=true
VOLUNTEER_REGISTRATIONS_ENABLED=true
# Segredo exclusivo para links de resposta; gerar no servidor e manter privado.
REGISTRATION_LINK_SECRET=
PORT=3085
WEB_URL=http://localhost:5173
# PostgreSQL local: substituir SENHA_URL_ENCODED; nunca versionar credenciais.
# Caracteres especiais da senha devem ser codificados para uma URL.
# Estrutura manual PT-BR: não executar as migrations antigas nesta base.
DATABASE_URL="postgresql://postgres:SENHA_URL_ENCODED@localhost:5432/eventos_beta?schema=acesso&connect_timeout=5"
DIRECT_URL="postgresql://postgres:SENHA_URL_ENCODED@localhost:5432/eventos_beta?schema=acesso&connect_timeout=5"
# Para banco no Supabase, usar a URL real do provedor e o SSL indicado por ele.
# SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_PRIVATE_BUCKET=identificacao
SUPABASE_ARTWORK_BUCKET=artes-eventos
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# ID de uma conta Supabase existente e com e-mail confirmado. Usado somente pelo comando restrito.
BOOTSTRAP_ADMIN_USER_ID=
